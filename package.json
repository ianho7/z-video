{
  "name": "z-video-electron",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-first Electron client for z-video",
  "main": "dist/src/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-renderer-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:window": "npm run build && node scripts/run-window-smoke.mjs",
    "test:appearance-window": "npm run build && node scripts/run-appearance-window-smoke.mjs",
    "test:player-window": "npm run build && electron dist/tests/player-window-smoke.js",
    "test:nas-player-window": "npm run build && electron dist/tests/nas-player-window-smoke.js",
    "test:safe-storage-process": "npm run build && node scripts/run-safe-storage-process-smoke.mjs",
    "package": "npm run build && node scripts/package-windows.mjs",
    "verify:package": "node scripts/verify-windows-package.mjs",
    "measure:windows": "node scripts/measure-windows-resources.mjs",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "45.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "koffi": "3.3.5"
  }
}
