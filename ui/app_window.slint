import { Button, Slider, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";

export struct ClassificationUiItem {
    id: string,
    name: string,
    count: int,
    is_selected: bool,
}

export struct CollectionUiItem {
    collection_id: string,
    title: string,
    release_year: string,
    video_type: string,
    score: string,
    cover_image: image,
    has_cover: bool,
}

export component AppWindow inherits Window {
    title: app_title;
    min_width: 900px;
    min_height: 640px;
    preferred_width: 1040px;
    preferred_height: 720px;
    background: #121418;

    // View state
    in-out property <bool> is_logged_in: false;
    in-out property <string> current_view: "library"; // "library" | "player"

    // Login Form State
    in-out property <string> server_url_input: "192.168.1.100";
    in-out property <string> username_input: "";
    in-out property <string> password_input: "";
    in-out property <string> sms_code_input: "";
    in-out property <bool> show_sms_field: false;
    in-out property <bool> remember_credentials: true;
    in-out property <bool> login_loading: false;
    in-out property <string> login_error_message: "";
    in-out property <string> login_status_hint: "请输入极空间局域网 IP (默认端口 5055) 与管理账号密码";

    // Active Authenticated Session Profile
    in-out property <string> session_user: "";
    in-out property <string> session_nas_name: "";
    in-out property <string> session_base_url: "";

    // Library State
    in-out property <[ClassificationUiItem]> classifications: [];
    in-out property <[CollectionUiItem]> collections: [];
    in-out property <string> selected_classification_id: "";
    in-out property <string> selected_classification_name: "全部影片";
    in-out property <bool> library_loading: false;
    in-out property <string> library_error: "";
    in-out property <int> collection_count: 0;

    // App & Player Diagnostic Info
    in-out property <string> app_title: "z-video — 极空间影视客户端";
    in-out property <string> engine_name: "libmpv 2.6 (Direct3D 11 / HWDEC)";
    in-out property <string> playback_status: "Idle";
    in-out property <string> media_path: "未载入测试视频";
    in-out property <string> time_label: "00:00 / 00:00";
    in-out property <float> progress_value: 0.0;
    in-out property <float> duration_value: 100.0;
    in-out property <bool> is_playing: false;
    in-out property <string> status_message: "就绪。已通过局域网安全鉴权。";
    in-out property <int> ui_heartbeat_count: 0;

    // Video surface layout geometry for Win32 child HWND embedding (only active in player view)
    out property <length> video_area_x: (root.is_logged_in && root.current_view == "player") ? video_container.x : 0px;
    out property <length> video_area_y: (root.is_logged_in && root.current_view == "player") ? video_container.y : 0px;
    out property <length> video_area_width: (root.is_logged_in && root.current_view == "player") ? video_container.width : 0px;
    out property <length> video_area_height: (root.is_logged_in && root.current_view == "player") ? video_container.height : 0px;

    // Authentication Callbacks
    callback login_requested(string, string, string, string, bool);
    callback logout_requested();

    // Library Callbacks
    callback select_classification(string);
    callback collection_clicked(string);
    callback refresh_library_clicked();
    callback switch_view(string);

    // Player Callbacks
    callback play_clicked();
    callback pause_clicked();
    callback toggle_pause_clicked();
    callback stop_clicked();
    callback seek_relative(float);
    callback seek_absolute(float);
    callback load_sample_clicked();

    // ==========================================
    // 1. LOGIN VIEW (Visible when !is_logged_in)
    // ==========================================
    if !root.is_logged_in: VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: center;

        // Top Status Line
        HorizontalLayout {
            alignment: space_between;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "z-video 极空间影视客户端";
                    color: #ffffff;
                    font_size: 16px;
                    font_weight: 700;
                    vertical_alignment: center;
                }
                Rectangle {
                    background: #2a3340;
                    border_radius: 4px;
                    height: 22px;
                    HorizontalLayout {
                        padding_left: 6px;
                        padding_right: 6px;
                        Text {
                            text: root.engine_name;
                            color: #64b5f6;
                            font_size: 11px;
                            vertical_alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                background: #232830;
                border_radius: 4px;
                height: 22px;
                HorizontalLayout {
                    padding_left: 8px;
                    padding_right: 8px;
                    Text {
                        text: "UI 线程活跃 (tick: " + root.ui_heartbeat_count + ")";
                        color: #81c784;
                        font_size: 11px;
                        vertical_alignment: center;
                    }
                }
            }
        }

        // Center Login Card
        Rectangle {
            horizontal_stretch: 0;
            width: 480px;
            background: #1c2026;
            border_radius: 12px;
            border_color: #2e3846;
            border_width: 1px;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;

                // Card Header
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "局域网 NAS 安全登录";
                        color: #ffffff;
                        font_size: 18px;
                        font_weight: 700;
                        horizontal_alignment: center;
                    }
                    Text {
                        text: root.login_status_hint;
                        color: #90a4ae;
                        font_size: 12px;
                        horizontal_alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Error Banner
                if root.login_error_message != "": Rectangle {
                    background: #381a1d;
                    border_color: #e53935;
                    border_width: 1px;
                    border_radius: 6px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "⚠ 认证或连接异常";
                                color: #ff8a80;
                                font_size: 12px;
                                font_weight: 700;
                            }
                        }

                        Text {
                            text: root.login_error_message;
                            color: #ffebee;
                            font_size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Fields
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "极空间访问地址 (LAN IP / Host)";
                        color: #cfd8dc;
                        font_size: 12px;
                        font_weight: 500;
                    }
                    LineEdit {
                        text: root.server_url_input;
                        placeholder_text: "例如: 192.168.1.100 或 192.168.1.100:5055";
                        enabled: !root.login_loading;
                        edited(val) => { root.server_url_input = val; }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "账号 (Username)";
                        color: #cfd8dc;
                        font_size: 12px;
                        font_weight: 500;
                    }
                    LineEdit {
                        text: root.username_input;
                        placeholder_text: "请输入极空间账号 / 手机号";
                        enabled: !root.login_loading;
                        edited(val) => { root.username_input = val; }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "密码 (Password - RSA 公钥独立加密传输)";
                        color: #cfd8dc;
                        font_size: 12px;
                        font_weight: 500;
                    }
                    LineEdit {
                        text: root.password_input;
                        placeholder_text: "请输入登录密码";
                        input_type: password;
                        enabled: !root.login_loading;
                        edited(val) => { root.password_input = val; }
                        accepted => {
                            if !root.login_loading && root.server_url_input != "" && root.username_input != "" {
                                root.login_requested(
                                    root.server_url_input,
                                    root.username_input,
                                    root.password_input,
                                    root.sms_code_input,
                                    root.remember_credentials
                                );
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space_between;
                        Text {
                            text: "短信/安全验证码 (SMS Code)";
                            color: root.show_sms_field ? #ffb74d : #90a4ae;
                            font_size: 12px;
                            font_weight: root.show_sms_field ? 700 : 400;
                        }
                        if root.show_sms_field: Text {
                            text: "【必须输入验证码以完成二次鉴权】";
                            color: #ffb74d;
                            font_size: 11px;
                        }
                    }
                    LineEdit {
                        text: root.sms_code_input;
                        placeholder_text: root.show_sms_field ? "请输入收到的短信/邮件验证码" : "如开启两步验证或遇到新设备验证时输入";
                        enabled: !root.login_loading;
                        edited(val) => { root.sms_code_input = val; }
                    }
                }

                HorizontalLayout {
                    alignment: space_between;
                    CheckBox {
                        text: "记住登录凭证 (安全存储至系统凭据管理器)";
                        checked: root.remember_credentials;
                        toggled => {
                            root.remember_credentials = !root.remember_credentials;
                        }
                    }
                }

                Button {
                    text: root.login_loading ? "正在连接 NAS 并验证身份..." : "登 录 (Login)";
                    primary: true;
                    enabled: !root.login_loading && root.server_url_input != "" && root.username_input != "";
                    clicked => {
                        root.login_requested(
                            root.server_url_input,
                            root.username_input,
                            root.password_input,
                            root.sms_code_input,
                            root.remember_credentials
                        );
                    }
                }

                if root.login_loading: HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "正在执行局域网 RSA 密钥握手与独立加密校验...";
                        color: #64b5f6;
                        font_size: 12px;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: "极空间原生轻量客户端 — 凭据通过系统安全凭据管理器加密保存，绝不明文输出";
                color: #546e7a;
                font_size: 11px;
            }
        }
    }

    // ==========================================
    // 2. MAIN LOGGED-IN WORKSPACE
    // ==========================================
    VerticalLayout {
        visible: root.is_logged_in;
        padding: 16px;
        spacing: 12px;

        // Top Shared Header Bar
        Rectangle {
            height: 52px;
            background: #1c2026;
            border_radius: 8px;

            HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                alignment: space_between;

                // Left: Title & Navigation Tabs
                HorizontalLayout {
                    spacing: 12px;
                    y: 11px;

                    Text {
                        text: "极影视";
                        color: #ffffff;
                        font_size: 18px;
                        font_weight: 800;
                        vertical_alignment: center;
                    }

                    // View switch: Library vs Player
                    Rectangle {
                        background: root.current_view == "library" ? #2979ff : #263238;
                        border_radius: 4px;
                        height: 28px;
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            Text {
                                text: "片库海报墙";
                                color: #ffffff;
                                font_size: 12px;
                                font_weight: root.current_view == "library" ? 700 : 500;
                                vertical_alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.current_view = "library";
                                root.switch_view("library");
                            }
                        }
                    }

                    Rectangle {
                        background: root.current_view == "player" ? #2979ff : #263238;
                        border_radius: 4px;
                        height: 28px;
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            Text {
                                text: "播放器探针";
                                color: #ffffff;
                                font_size: 12px;
                                font_weight: root.current_view == "player" ? 700 : 500;
                                vertical_alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.current_view = "player";
                                root.switch_view("player");
                            }
                        }
                    }
                }

                // Right: Session Profile & Actions
                HorizontalLayout {
                    spacing: 10px;
                    y: 13px;

                    Rectangle {
                        background: #1e3a2f;
                        border_color: #2e7d32;
                        border_width: 1px;
                        border_radius: 4px;
                        height: 26px;

                        HorizontalLayout {
                            padding_left: 8px;
                            padding_right: 8px;
                            Text {
                                text: "NAS: " + (root.session_nas_name != "" ? root.session_nas_name : root.session_base_url) + " (" + root.session_user + ")";
                                color: #a5d6a7;
                                font_size: 11px;
                                font_weight: 600;
                                vertical_alignment: center;
                            }
                        }
                    }

                    Button {
                        text: "注销会话";
                        clicked => {
                            root.logout_requested();
                        }
                    }
                }
            }
        }

        // ==========================================
        // 2A. LIBRARY VIEW (Default)
        // ==========================================
        VerticalLayout {
            visible: root.current_view == "library";
            spacing: 12px;
            vertical_stretch: 1;

            // Classification Filter Sub-bar
            Rectangle {
                height: 44px;
                background: #191c22;
                border_radius: 6px;

                HorizontalLayout {
                    padding_left: 12px;
                    padding_right: 12px;
                    spacing: 8px;
                    alignment: start;

                    for cat in root.classifications: Rectangle {
                        background: cat.is_selected ? #37474f : #21262d;
                        border_color: cat.is_selected ? #64b5f6 : transparent;
                        border_width: 1px;
                        border_radius: 14px;
                        height: 28px;
                        y: 8px;

                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            Text {
                                text: cat.name;
                                color: cat.is_selected ? #ffffff : #b0bec5;
                                font_size: 12px;
                                font_weight: cat.is_selected ? 700 : 400;
                                vertical_alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_classification(cat.id);
                            }
                        }
                    }

                    // Spacer
                    Rectangle { horizontal_stretch: 1; }

                    // Refresh Button
                    Button {
                        text: "刷新片库";
                        clicked => {
                            root.refresh_library_clicked();
                        }
                    }
                }
            }

            // Error Banner in Library
            if root.library_error != "": Rectangle {
                height: 48px;
                background: #381a1d;
                border_color: #e53935;
                border_width: 1px;
                border_radius: 6px;

                HorizontalLayout {
                    padding_left: 16px;
                    padding_right: 16px;
                    alignment: space_between;

                    Text {
                        text: "⚠ " + root.library_error;
                        color: #ffcdd2;
                        font_size: 13px;
                        vertical_alignment: center;
                    }

                    Button {
                        text: "重试加载";
                        clicked => {
                            root.refresh_library_clicked();
                        }
                    }
                }
            }

            // Loading state
            if root.library_loading: Rectangle {
                vertical_stretch: 1;
                background: #16191f;
                border_radius: 6px;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "正在从极空间拉取片库元数据与海报...";
                        color: #64b5f6;
                        font_size: 15px;
                        font_weight: 600;
                        horizontal_alignment: center;
                    }
                    Text {
                        text: "分类: " + root.selected_classification_name;
                        color: #90a4ae;
                        font_size: 12px;
                        horizontal_alignment: center;
                    }
                }
            }

            // Empty state
            if !root.library_loading && root.collections.length == 0 && root.library_error == "": Rectangle {
                vertical_stretch: 1;
                background: #16191f;
                border_radius: 6px;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "该分类下暂无影视内容";
                        color: #cfd8dc;
                        font_size: 16px;
                        font_weight: 600;
                        horizontal_alignment: center;
                    }
                    Text {
                        text: "请确认极空间 NAS 中极影视已添加对应媒体文件夹或稍后刷新";
                        color: #78909c;
                        font_size: 12px;
                        horizontal_alignment: center;
                    }
                    Button {
                        text: "刷新数据";
                        clicked => {
                            root.refresh_library_clicked();
                        }
                    }
                }
            }

            // Collection Poster Grid View (ScrollView)
            if !root.library_loading && root.collections.length > 0: ScrollView {
                vertical_stretch: 1;

                VerticalLayout {
                    padding: 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space_between;
                        Text {
                            text: root.selected_classification_name + " (" + root.collections.length + " 部作品)";
                            color: #eceff1;
                            font_size: 14px;
                            font_weight: 700;
                        }
                    }

                    // Flexible flow grid list
                    VerticalLayout {
                        spacing: 14px;

                        for col in root.collections: Rectangle {
                            height: 120px;
                            background: #1c2027;
                            border_radius: 8px;
                            border_color: touch.has_hover ? #42a5f5 : #2a3340;
                            border_width: 1px;
                            animate border_color { duration: 150ms; }

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 14px;

                                // Poster / Cover Image Container
                                Rectangle {
                                    width: 74px;
                                    height: 100px;
                                    background: #252b36;
                                    border_radius: 4px;
                                    clip: true;

                                    if col.has_cover: Image {
                                        source: col.cover_image;
                                        width: 100%;
                                        height: 100%;
                                        image_fit: cover;
                                    }

                                    if !col.has_cover: VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "🎬";
                                            font_size: 24px;
                                            horizontal_alignment: center;
                                        }
                                    }
                                }

                                // Information details
                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    horizontal_stretch: 1;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: col.title;
                                            color: #ffffff;
                                            font_size: 15px;
                                            font_weight: 700;
                                        }

                                        if col.score != "": Rectangle {
                                            background: #ff8f00;
                                            border_radius: 3px;
                                            height: 18px;
                                            HorizontalLayout {
                                                padding_left: 4px;
                                                padding_right: 4px;
                                                Text {
                                                    text: "★ " + col.score;
                                                    color: #000000;
                                                    font_size: 10px;
                                                    font_weight: 800;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: "上映年份: " + (col.release_year != "" ? col.release_year : "未知");
                                            color: #90a4ae;
                                            font_size: 12px;
                                        }
                                        Text {
                                            text: "类型: " + col.video_type;
                                            color: #90a4ae;
                                            font_size: 12px;
                                        }
                                    }

                                    Text {
                                        text: "点击进入详情 / 准备播放";
                                        color: touch.has_hover ? #64b5f6 : #546e7a;
                                        font_size: 11px;
                                    }
                                }

                                // Play action hint button
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "查看 / 播放";
                                        clicked => {
                                            root.collection_clicked(col.collection_id);
                                        }
                                    }
                                }
                            }

                            touch := TouchArea {
                                clicked => {
                                    root.collection_clicked(col.collection_id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 2B. PLAYER PROBE VIEW
        // ==========================================
        VerticalLayout {
            visible: root.current_view == "player";
            spacing: 12px;
            vertical_stretch: 1;

            video_container := Rectangle {
                vertical_stretch: 1;
                background: #000000;
                border_radius: 6px;
                clip: true;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: root.playback_status == "Idle" ? "【原生视频画面嵌入表面】" : "";
                        color: #555555;
                        font_size: 16px;
                        horizontal_alignment: center;
                    }
                    Text {
                        text: root.playback_status == "Idle" ? "Windows Win32 HWND + Direct3D 11 Swapchain" : "";
                        color: #444444;
                        font_size: 12px;
                        horizontal_alignment: center;
                    }
                }
            }

            // Bottom: Media Info & Control Dock
            Rectangle {
                height: 128px;
                background: #1c2026;
                border_radius: 8px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space_between;

                        Text {
                            text: "媒体: " + root.media_path;
                            color: #90a4ae;
                            font_size: 12px;
                            overflow: elide;
                        }

                        Text {
                            text: root.status_message;
                            color: #b0bec5;
                            font_size: 12px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Slider {
                            horizontal_stretch: 1;
                            minimum: 0.0;
                            maximum: root.duration_value > 0.0 ? root.duration_value : 100.0;
                            value: root.progress_value;
                            changed(val) => {
                                root.seek_absolute(val);
                            }
                        }

                        Text {
                            text: root.time_label;
                            color: #ffffff;
                            font_size: 13px;
                            font_weight: 600;
                            vertical_alignment: center;
                            min_width: 100px;
                            horizontal_alignment: right;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Button {
                            text: "载入样本视频 (assets/test_video.mp4)";
                            primary: true;
                            clicked => {
                                root.load_sample_clicked();
                            }
                        }

                        Button {
                            text: root.is_playing ? "暂停 (Pause)" : "播放 (Play)";
                            clicked => {
                                root.toggle_pause_clicked();
                            }
                        }

                        Button {
                            text: "停止 (Stop)";
                            clicked => {
                                root.stop_clicked();
                            }
                        }

                        Button {
                            text: "快退 -5s";
                            clicked => {
                                root.seek_relative(-5.0);
                            }
                        }

                        Button {
                            text: "快进 +5s";
                            clicked => {
                                root.seek_relative(5.0);
                            }
                        }
                    }
                }
            }
        }
    }
}
