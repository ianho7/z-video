import { Button, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: app_title;
    min_width: 800px;
    min_height: 600px;
    preferred_width: 960px;
    preferred_height: 680px;
    background: #121418;

    in-out property <string> app_title: "z-video — Windows 原生播放引擎嵌入探针";
    in-out property <string> engine_name: "libmpv 2.6 (Direct3D 11 / HWDEC)";
    in-out property <string> playback_status: "Idle";
    in-out property <string> media_path: "未载入测试视频";
    in-out property <string> time_label: "00:00 / 00:00";
    in-out property <float> progress_value: 0.0;
    in-out property <float> duration_value: 100.0;
    in-out property <bool> is_playing: false;
    in-out property <string> status_message: "就绪。点击下方【载入样本视频】开始测试原生渲染。";
    in-out property <int> ui_heartbeat_count: 0;

    out property <length> video_area_x: video_container.x;
    out property <length> video_area_y: video_container.y;
    out property <length> video_area_width: video_container.width;
    out property <length> video_area_height: video_container.height;

    callback play_clicked();
    callback pause_clicked();
    callback toggle_pause_clicked();
    callback stop_clicked();
    callback seek_relative(float);
    callback seek_absolute(float);
    callback load_sample_clicked();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Header Bar
        Rectangle {
            height: 50px;
            background: #1c2026;
            border_radius: 8px;

            HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                alignment: space_between;

                // Left: Title and Engine Info
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "z-video 极空间影视客户端";
                        color: #ffffff;
                        font_size: 16px;
                        font_weight: 700;
                        vertical_alignment: center;
                    }

                    Rectangle {
                        background: #2a3340;
                        border_radius: 4px;
                        height: 24px;
                        y: 13px;

                        HorizontalLayout {
                            padding_left: 8px;
                            padding_right: 8px;
                            Text {
                                text: root.engine_name;
                                color: #64b5f6;
                                font_size: 11px;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Right: Status Badge & UI heartbeat
                HorizontalLayout {
                    spacing: 12px;
                    y: 13px;

                    // Heartbeat indicator showing UI thread is non-blocking and active
                    Rectangle {
                        background: #232830;
                        border_radius: 4px;
                        height: 24px;

                        HorizontalLayout {
                            padding_left: 8px;
                            padding_right: 8px;
                            Text {
                                text: "UI 线程活跃 (tick: " + root.ui_heartbeat_count + ")";
                                color: #81c784;
                                font_size: 11px;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Playback Status Badge
                    Rectangle {
                        background: root.playback_status == "Playing" ? #1b5e20 :
                                    root.playback_status == "Paused" ? #e65100 :
                                    root.playback_status == "Stopped" ? #424242 : #263238;
                        border_radius: 4px;
                        height: 24px;

                        HorizontalLayout {
                            padding_left: 10px;
                            padding_right: 10px;
                            Text {
                                text: "状态: " + root.playback_status;
                                color: #ffffff;
                                font_size: 12px;
                                font_weight: 600;
                                vertical_alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Center: Native Video Surface Placeholder Area
        video_container := Rectangle {
            vertical_stretch: 1;
            background: #000000;
            border_radius: 6px;
            clip: true;

            // Placeholder hint shown when no video is rendered or before surface attachment
            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: root.playback_status == "Idle" ? "【原生视频画面嵌入表面】" : "";
                    color: #555555;
                    font_size: 16px;
                    horizontal_alignment: center;
                }
                Text {
                    text: root.playback_status == "Idle" ? "Windows Win32 HWND + Direct3D 11 Swapchain" : "";
                    color: #444444;
                    font_size: 12px;
                    horizontal_alignment: center;
                }
            }
        }

        // Bottom: Media Info & Control Dock
        Rectangle {
            height: 128px;
            background: #1c2026;
            border_radius: 8px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // Media Path & Diagnostic line
                HorizontalLayout {
                    alignment: space_between;

                    Text {
                        text: "媒体: " + root.media_path;
                        color: #90a4ae;
                        font_size: 12px;
                        overflow: elide;
                    }

                    Text {
                        text: root.status_message;
                        color: #b0bec5;
                        font_size: 12px;
                    }
                }

                // Progress Bar & Time Label
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Slider {
                        horizontal_stretch: 1;
                        minimum: 0.0;
                        maximum: root.duration_value > 0.0 ? root.duration_value : 100.0;
                        value: root.progress_value;
                        changed(val) => {
                            root.seek_absolute(val);
                        }
                    }

                    Text {
                        text: root.time_label;
                        color: #ffffff;
                        font_size: 13px;
                        font_weight: 600;
                        vertical_alignment: center;
                        min_width: 100px;
                        horizontal_alignment: right;
                    }
                }

                // Buttons Row
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Button {
                        text: "载入样本视频 (assets/test_video.mp4)";
                        primary: true;
                        clicked => {
                            root.load_sample_clicked();
                        }
                    }

                    Button {
                        text: root.is_playing ? "暂停 (Pause)" : "播放 (Play)";
                        clicked => {
                            root.toggle_pause_clicked();
                        }
                    }

                    Button {
                        text: "停止 (Stop)";
                        clicked => {
                            root.stop_clicked();
                        }
                    }

                    Button {
                        text: "快退 -5s";
                        clicked => {
                            root.seek_relative(-5.0);
                        }
                    }

                    Button {
                        text: "快进 +5s";
                        clicked => {
                            root.seek_relative(5.0);
                        }
                    }
                }
            }
        }
    }
}
